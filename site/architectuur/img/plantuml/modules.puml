@startuml
title Modules, lagen en regeldekking
left to right direction
package "kern" {
  [:core\n<size:10>tenancy: config, globaal</size>] as core
}
package "gedeelde infrastructuur" {
  [:graphql] as graphql
  [:portal-authentication] as portal_authentication
}
package "functionaliteit" {
  [:form\n<size:10>tenancy: config</size>] as form
  [:haalcentraal-hr\n<size:10>tenancy: config, webclient</size>] as haalcentraal_hr
  [:haalcentraal2\n<size:10>tenancy: config</size>] as haalcentraal2
  [:payment-direct\n<size:10>tenancy: config, webclient, globaal</size>] as payment_direct
  [:zgw:berichten\n<size:10>tenancy: config</size>] as zgw_berichten
  [:zgw:besluiten\n<size:10>tenancy: config</size>] as zgw_besluiten
  [:zgw:catalogi-api\n<size:10>tenancy: config, webclient</size>] as zgw_catalogi_api
  [:zgw:common-ground-authentication / :zgw:common-ground-authentication-test\n<size:10>tenancy: config, webclient</size>] as zgw_common_ground_authentication
  [:zgw:documenten-api\n<size:10>tenancy: config, webclient</size>] as zgw_documenten_api
  [:zgw:idtoken-authentication] as zgw_idtoken_authentication
  [:zgw:objectenapi\n<size:10>tenancy: config, webclient</size>] as zgw_objectenapi
  [:zgw:openklant\n<size:10>tenancy: config, webclient</size>] as zgw_openklant
  [:zgw:openproduct\n<size:10>tenancy: config, webclient</size>] as zgw_openproduct
  [:zgw:taak\n<size:10>tenancy: config</size>] as zgw_taak
  [:zgw:verificatie\n<size:10>tenancy: config, webclient</size>] as zgw_verificatie
  [:zgw:zaken] as zgw_zaken
  [:zgw:zaken-api\n<size:10>tenancy: config</size>] as zgw_zaken_api
}
package "applicatie" {
  [:app / :app-dev] as app
}
