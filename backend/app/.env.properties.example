# --- Form ---
NLPORTAL_CONFIG_FORM_PROPERTIES_FORMDEFINITIONOBJECTTYPEURL=http://localhost:8010/api/v2/objecttypes/4b5f4fba-0746-11ed-b939-0242ac120002

# --- OpenProduct (optional) ---
NLPORTAL_CONFIG_OPENPRODUCT_ENABLED=true
NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_PRODUCTAPIURL=http://localhost:8015/producten/api/v1
NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_PRODUCTTYPEAPIURL=http://localhost:8015/producttypen/api/v1
NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_TOKEN=ac045222c9e7cde8120b48735560f9b920bb58cd
NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_PREFILL_TYPEURL=http://localhost:8010/api/v2/objecttypes/e3cb704f-4091-40c7-a1ee-e8443e74ed0e

# --- HaalCentraal BRP ---
NLPORTAL_CONFIG_HAALCENTRAALBRP_ENABLED=true
NLPORTAL_CONFIG_HAALCENTRAALBRP_PROPERTIES_BRPAPIURL=http://localhost:5010/haalcentraal/api/brp/
NLPORTAL_CONFIG_HAALCENTRAALBRP_PROPERTIES_BEWONINGAPIURL=http://localhost:5011/haalcentraal/api/bewoning/

# --- Product module ---
NLPORTAL_CONFIG_PRODUCT_ENABLED=true
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTTYPEURL=http://localhost:8010/api/v2/objecttypes/972e92ce-b964-4ca8-ad4d-ddc43dd7b244
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTINSTANTIETYPEURL=http://localhost:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb34
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTVERBRUIKSOBJECTTYPEURL=http://localhost:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb37
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTDETAILSTYPEURL=http://localhost:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb36

# --- Prefill (host uses localhost, not host.docker.internal) ---
NLPORTAL_CONFIG_PREFILL_ENABLED=true
NLPORTAL_CONFIG_PREFILL_PROPERTIES_TYPEURL=http://localhost:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb37

# --- DMN ---
NLPORTAL_CONFIG_DMN_ENABLED=true
NLPORTAL_CONFIG_DMN_PROPERTIES_URL=http://localhost:8010

# --- OIDC realm ---
OIDC_REALM=nlportal

# --- Frontend features (served to the SPA via GET /api/public/frontend) ---
NLPORTAL_FRONTEND_TOGGLES_MESSAGECOUNTENABLED=true
NLPORTAL_FRONTEND_TOGGLES_CASESPARTIALSEARCHENABLED=true
NLPORTAL_FRONTEND_TOGGLES_MYINHABITANTCOUNTENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OPENPRODUCTENABLED=true
NLPORTAL_FRONTEND_TOGGLES_CASESRESULTEXPLANATIONENABLED=false
NLPORTAL_FRONTEND_TOGGLES_CASESCONTACTMOMENTSENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OVERVIEWINTROENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OVERVIEWMAINTENANCEALERTENABLED=true
NLPORTAL_FRONTEND_PROPERTIES_MESSAGECOUNTPOLLINGINTERVAL=10000
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWCURRENTCASESPREVIEWLENGTH=4
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWCURRENTTASKSPREVIEWLENGTH=4
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLENL=Ontwikkelmodus
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLEEN=Development mode
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTNL=Deze omgeving draait in ontwikkelmodus met testgegevens.
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTEN=This environment is running in development mode with test data.
