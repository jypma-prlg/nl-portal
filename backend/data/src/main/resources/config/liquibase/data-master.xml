<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- Cleanup after removal of the backend/case module (ADR 0010). -->
    <changeSet author="nl-portal" id="drop-case-tables-adr-0010" objectQuotingStrategy="QUOTE_ALL_OBJECTS">
        <preConditions onFail="MARK_RAN">
            <or>
                <tableExists tableName="case"/>
                <tableExists tableName="case_definition"/>
            </or>
        </preConditions>
        <dropTable tableName="case" ifExists="true"/>
        <dropTable tableName="case_definition" ifExists="true"/>
    </changeSet>

</databaseChangeLog>
