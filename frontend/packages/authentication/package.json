    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "^10.2.2",
    "react-router": "^8.5.1",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.2",
