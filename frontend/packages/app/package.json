{
  "name": "nl-portal-app",
  "version": "0.0.0",
  "author": "Ritense",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "pnpm wait && vite --port 3000 --mode development",
    "wait": "wait-on ../api/dist/index.js && wait-on ../authentication/dist/index.js && wait-on ../localization/dist/index.js && wait-on ../user-interface/dist/index.js",
    "build": "pnpm wait && tsc && vite build",
    "preinstall": "npx only-allow pnpm",
    "preview": "vite preview --port 3000",
    "generate-pwa-assets": "pnpm dlx pwa-asset-generator@8.1.5 ./src/assets/pwa-logo.svg ./public/pwa --favicon --mstile --opaque  false --maskable true --index  index.html --manifest ./public/manifest.json --path-override '../pwa'",
    "clean": "rimraf build",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "@gemeente-denhaag/design-tokens": "1.6.0",
    "@gemeente-denhaag/icons": "4.3.0",
    "@nl-portal/nl-portal-api": "workspace:*",
    "@nl-portal/nl-portal-authentication": "workspace:*",
    "@nl-portal/nl-portal-localization": "workspace:*",
    "@nl-portal/nl-portal-user-interface": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "^10.1.23",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "4.1.12",
    "wait-on": "9.5.1"
  }
}
