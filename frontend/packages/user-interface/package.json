    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm wait && tsc && vite build",
    "build:watch": "pnpm wait && tsc && vite build --watch --mode development",
    "clean": "rimraf dist",
    "dev": "pnpm wait && vite build --watch --mode development",
    "preinstall": "npx only-allow pnpm",
    "wait": "wait-on ../api/dist/index.js && wait-on ../authentication/dist/index.js && wait-on ../localization/dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "DEBUG_PRINT_LIMIT=100000 vitest --watch --ui",
    "typecheck": "tsc --noEmit"
  },
