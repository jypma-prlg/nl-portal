{
  "name": "@nl-portal/nl-portal-api",
  "version": "0.0.0",
  "author": "Ritense",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm wait && tsc && vite build",
    "build:watch": "pnpm wait && tsc && vite build --watch --mode development",
    "clean": "rimraf dist",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "pnpm wait && vite build --watch --mode development",
    "preinstall": "npx only-allow pnpm",
    "wait": "wait-on ../authentication/dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "4.3.5",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-codegen/typed-document-node": "7.2.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@nl-portal/nl-portal-authentication": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "peerDependencies": {
    "@nl-portal/nl-portal-authentication": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
