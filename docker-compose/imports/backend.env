#NLPORTAL_CONFIG_PAYMENT_DIRECT_ENABLED=false
#NLPORTAL_CONFIG_PAYMENT_DIRECT_PROPERTIES_URL=
#NLPORTAL_CONFIG_PAYMENT_DIRECT_PROPERTIES_SSL_ENABLED=false
#NLPORTAL_CONFIG_PAYMENT_DIRECT_PROPERTIES_SHAOUTPARAMETERS=
#NLPORTAL_CONFIG_PAYMENT_DIRECT_PROPERTIES_WEBHOOKHEADERS=
