# =============================================================================
# NL Portal Backend Configuration
# =============================================================================
# This file configures the Spring Boot backend for nl-portal-app.
# Environment variables follow Spring Boot relaxed binding:
#   nl-portal.config.module.property → NLPORTAL_CONFIG_MODULE_PROPERTY
#
# Required services (docker-compose profiles):
#   - Keycloak: always required
#   - zgw: OpenZaak, ObjectenAPI, etc.
#   - haalcentraal: BRP/Bewoning mocks
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication - Keycloak
# -----------------------------------------------------------------------------
JWKS_URI=http://localhost:8082/auth/realms/nlportal/protocol/openid-connect/certs
# Standard token exchange: needs no KC_FEATURES and no token-exchange target client.
# See site/hosting-en-configuratie/keycloak-token-exchange.md
KEYCLOAK_CLIENT_ID=nl-portal-m2m
# KEYCLOAK_CLIENT_SECRET komt uit docker-compose/.env (gegenereerd door `mise run dev:setup`); zie compose.localhost-*.yaml.
# Optional audience filter for the exchanged token. Leave empty unless the m2m client can issue it.
KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=
# Direct property overrides.
#NLPORTAL_AUTHENTICATION_KEYCLOAK_RESOURCE=
#NLPORTAL_AUTHENTICATION_KEYCLOAK_AUDIENCE=
#NLPORTAL_AUTHENTICATION_KEYCLOAK_CREDENTIALS_SECRET=

# -----------------------------------------------------------------------------
# Authentication - Machtigingsdienst (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_AUTHENTICATION_MACHTINGSDIENST_RESOURCEURL=
#NLPORTAL_AUTHENTICATION_MACHTINGSDIENST_ALLMACHTIGINGUUID=

# -----------------------------------------------------------------------------
# Security - CORS
# De backend staat standaard geen cross-origin verzoeken toe. Onderstaande ruime
# waarden zijn alleen voor de lokale compose-stack; zet in een echte omgeving
# expliciete origins (zie site/hosting-en-configuratie/deployment-guide.md).
# -----------------------------------------------------------------------------
NLPORTAL_SECURITY_CORS_0_PATH=/**
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDORIGINS=*
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDMETHODS=GET,POST,PUT,DELETE,OPTIONS
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDHEADERS=*

# -----------------------------------------------------------------------------
# Security - Endpoints (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_SECURITY_ENDPOINTS_UNSECURED=/actuator/health

# -----------------------------------------------------------------------------
# Security - Headers (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_SECURITY_HEADERS_CONTENTSECURITYPOLICY=default-src 'self'
#NLPORTAL_SECURITY_HEADERS_HSTSMAXAGEINDAYS=365

# -----------------------------------------------------------------------------
# Theme (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_CONFIG_THEME_STYLE=
#NLPORTAL_CONFIG_THEME_LOGO=

# -----------------------------------------------------------------------------
# Open Object
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_OBJECTENAPI_ENABLED=true
NLPORTAL_CONFIG_OBJECTENAPI_PROPERTIES_URL=http://localhost:8010
NLPORTAL_CONFIG_OBJECTENAPI_PROPERTIES_TOKEN=182c13e2209161852c53cef53a879f7a2f923430

# -----------------------------------------------------------------------------
# Zaken API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_ZAKENAPI_ENABLED=true
NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_URL=http://localhost:8001
NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_CLIENTID=nl-portal
NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_SECRET=DGXJs3GKU84LFZWWfdb!nk6gpL6mL9@A
#NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_ZAAKTYPESIDSEXCLUDED=uuid1,uuid2
#NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_USENNPKVKQUERYIDENTIFICATORS=false
NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_ZAAKDOCUMENTENCONFIG_STATUSWHITELIST=ter_vaststelling,in_bewerking,definitief,gearchiveerd
NLPORTAL_CONFIG_ZAKENAPI_PROPERTIES_ZAAKDOCUMENTENCONFIG_VERTROUWELIJKHEIDSAANDUIDINGWHITELIST=openbaar,beperkt_openbaar,intern,zaakvertrouwelijk,vertrouwelijk,confidentieel,geheim,zeer_geheim

# -----------------------------------------------------------------------------
# Catalogi API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_CATALOGIAPI_ENABLED=true
NLPORTAL_CONFIG_CATALOGIAPI_PROPERTIES_URL=http://localhost:8001
NLPORTAL_CONFIG_CATALOGIAPI_PROPERTIES_CLIENTID=nl-portal
NLPORTAL_CONFIG_CATALOGIAPI_PROPERTIES_SECRET=DGXJs3GKU84LFZWWfdb!nk6gpL6mL9@A

# -----------------------------------------------------------------------------
# Besluiten API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_BESLUITENAPI_ENABLED=true
NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_URL=http://localhost:8001
NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_CLIENTID=nl-portal
NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_SECRET=DGXJs3GKU84LFZWWfdb!nk6gpL6mL9@A

# -----------------------------------------------------------------------------
# Documenten APIs
# Multiple configurations supported, keyed by name (e.g., openzaak, dummydoc)
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_DOCUMENTENAPIS_ENABLED=true
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_DEFAULTDOCUMENTAPI=openzaak
#NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_ALLOWEDMIMETYPES=application/pdf,image/png,image/jpeg

# Configuration: openzaak
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_URL=http://localhost:8001/documenten/api/v1
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_CLIENTID=nl-portal
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_SECRET=DGXJs3GKU84LFZWWfdb!nk6gpL6mL9@A
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_RSIN=051845623
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_DOCUMENTTYPEURL=http://localhost:8001/catalogi/api/v1/informatieobjecttypen/36e40d95-e411-4884-b08f-e5864ec8167f
#NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_OPENZAAK_SSL_ENABLED=false

# Configuration: dummydoc (example secondary config)
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_DUMMYDOC_URL=http://localhost:8002/documenten/api/v1
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_DUMMYDOC_CLIENTID=docdoc
NLPORTAL_CONFIG_DOCUMENTENAPIS_PROPERTIES_CONFIGURATIONS_DUMMYDOC_SECRET=DGXJs3GKU84LFZWWfdb!nk6gpL6mL9@A

# -----------------------------------------------------------------------------
# ClamAV Virus Scan (optional)
# Start the scanner with the `clamav` compose profile, then flip ENABLED to true.
# It shares the `localhost` netns, so hostname stays localhost for both local
# (containerised backend) and sources (host bootRun) runs.
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_ENABLED=true
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_PROPERTIES_HOSTNAME=localhost
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_PROPERTIES_PORT=3310

