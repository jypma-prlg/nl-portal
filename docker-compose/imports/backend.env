# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOGLEVEL=INFO

# -----------------------------------------------------------------------------
# OIDC Realm (used by some modules)
# -----------------------------------------------------------------------------
OIDC_REALM=nlportal

# -----------------------------------------------------------------------------
# Frontend toggles and properties (served to the SPA via GET /api/public/frontend).
# messageCountEnabled is a feature flag: see imports/flags/nl-portal.flagd.json and
# site/hosting-en-configuratie/feature-flags.md.
# -----------------------------------------------------------------------------
NLPORTAL_FRONTEND_TOGGLES_CASESPARTIALSEARCHENABLED=true
NLPORTAL_FRONTEND_TOGGLES_MYINHABITANTCOUNTENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OPENPRODUCTENABLED=false
NLPORTAL_FRONTEND_TOGGLES_CASESRESULTEXPLANATIONENABLED=false
NLPORTAL_FRONTEND_TOGGLES_CASESCONTACTMOMENTSENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OVERVIEWINTROENABLED=true
NLPORTAL_FRONTEND_TOGGLES_OVERVIEWMAINTENANCEALERTENABLED=true
NLPORTAL_FRONTEND_PROPERTIES_MESSAGECOUNTPOLLINGINTERVAL=10000
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWCURRENTCASESPREVIEWLENGTH=4
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLENL=Ontwikkelmodus
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLEEN=Development mode
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTNL=Deze omgeving draait in ontwikkelmodus met testgegevens.
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTEN=This environment is running in development mode with test data.
#NLPORTAL_FRONTEND_PROPERTIES_THEMECLASS=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSRESEARCHURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSRESEARCHMOREINFOURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYNAMECHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYGENDERCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYBRPCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYBRPCONFIDENTIALLYCHANGEURL=

# -----------------------------------------------------------------------------
# Beheerpoort: gedetailleerde modulestatus (GET /actuator/modulestatus)
# -----------------------------------------------------------------------------
# Eigen poort voor beheer, naast 8080; zonder deze variabele draait beheer op de gewone poort.
# Alleen lokaal een {noop}-wachtwoord; gebruik elders een hash, zie site/hosting-en-configuratie/beheer-modulestatus.md
MANAGEMENT_SERVER_PORT=8091
NLPORTAL_BEHEER_GEBRUIKERSNAAM=beheer
NLPORTAL_BEHEER_WACHTWOORDHASH={noop}beheer
