# Niet met de hand kopieren: `mise run dev:setup` (repo-root) maakt `.env` aan op basis van dit bestand en voegt
# de gegenereerde secrets toe. `docker compose up` leest `.env` automatisch.

# Hoe de app draait: sources (standaard, geen app-container) | local (bouwen uit bronnen) | remote (gepubliceerde images)
RUN_MODE=sources
# Verplicht bij RUN_MODE=remote
#NL_PORTAL_IMAGE_TAG=

# Extern Docker-netwerk met de API's: uit (standaard) | mijngemeente
NETWERK=uit
